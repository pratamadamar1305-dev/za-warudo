{
  "name": "eurobeat-drift-legend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "simtest": "tsc -p tsconfig.sim.json && node simtest-out/tools/simtest.js",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/three": "^0.181.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "rimraf": "^6.1.4",
    "tar": "^7.5.23"
  }
}
